# Mailcubby configuration template. Copy to .env and adjust.
# Full reference: docs/SPEC.md section 9.
# Durations: 90s, 15m, 24h, 30d. Sizes: 25MiB, 1GiB. Rates: 600/m, 10/15m (0 disables).
# Secrets also accept <NAME>_FILE (e.g. MAILCUBBY_APP_KEY_FILE).

# --- General ---------------------------------------------------------------
# local = no login, any SMTP credentials accepted (development)
# server = multi-tenant with login (team / agency)
# Default: local. Leave unset for local mode, so Mailcubby refuses to open a
# server-mode data dir (one with users) without login.
# MAILCUBBY_MODE=local
# MAILCUBBY_DATA_DIR=/data
# Public URL of the web UI. Required in server mode.
# MAILCUBBY_BASE_URL=https://mail.example.com
# 32 random bytes, base64. Required in server mode. Generate: mailcubby keygen
# MAILCUBBY_APP_KEY=
# MAILCUBBY_APP_KEY_FILE=/run/secrets/mailcubby_app_key
# MAILCUBBY_INSTANCE_NAME=Mailcubby
# MAILCUBBY_DEFAULT_PROJECT=default
# Enables recipient routing: *@<project>.<domain> and <project>+tag@<domain>
# MAILCUBBY_INBOX_DOMAIN=inbox.example.com
# MAILCUBBY_LOG_LEVEL=info
# MAILCUBBY_LOG_FORMAT=text

# Headless bootstrap of the first admin (server mode, only if no users exist)
# MAILCUBBY_ADMIN_EMAIL=admin@example.com
# MAILCUBBY_ADMIN_PASSWORD=
# MAILCUBBY_ADMIN_PASSWORD_FILE=/run/secrets/mailcubby_admin_password

# SMTP address used by the "mailcubby sendmail" client subcommand
# MAILCUBBY_SENDMAIL_SMTP=localhost:1025

# --- HTTP ------------------------------------------------------------------
# MAILCUBBY_HTTP_ADDR=:8025
# Comma-separated CIDRs of reverse proxies allowed to set X-Forwarded-For
# MAILCUBBY_TRUSTED_PROXIES=172.16.0.0/12
# MAILCUBBY_SESSION_TTL=30d
# MAILCUBBY_SESSION_IDLE_TIMEOUT=7d
# MAILCUBBY_INVITE_TTL=7d
# MAILCUBBY_HSTS=true
# MAILCUBBY_LOGIN_RATE_LIMIT=10/15m
# MAILCUBBY_API_RATE_LIMIT=1200/m
# MAILCUBBY_API_WAIT_MAX_TIMEOUT=120s
# MAILCUBBY_SSE_MAX_CONNECTIONS_PER_USER=10
# opt-in = remote images blocked, user may load them per message; off = never
# MAILCUBBY_RENDER_REMOTE_IMAGES=opt-in
# Serve inline PDF attachment previews via /render/{project}/{id}/attachments/{attachment_id}
# MAILCUBBY_RENDER_INLINE_PDF=true

# --- SMTP ------------------------------------------------------------------
# MAILCUBBY_SMTP_ADDR=:1025
# MAILCUBBY_SMTPS_ADDR=:1465
# MAILCUBBY_SMTP_HOSTNAME=mailcubby
# Shown in connection info and snippets. Defaults: host of BASE_URL (else localhost);
# port 587 in server mode, 1025 in local mode
# MAILCUBBY_SMTP_PUBLIC_HOST=mail.example.com
# MAILCUBBY_SMTP_PUBLIC_PORT=587
# PEM files, reloaded automatically when they change
# MAILCUBBY_SMTP_TLS_CERT=
# MAILCUBBY_SMTP_TLS_KEY=
# Server mode requires TLS for AUTH unless this is true (default: false in server mode, true in local mode)
# MAILCUBBY_SMTP_ALLOW_INSECURE_AUTH=false
# Maximum 100MiB
# MAILCUBBY_SMTP_MAX_MESSAGE_BYTES=25MiB
# MAILCUBBY_SMTP_MAX_RECIPIENTS=100
# MAILCUBBY_SMTP_MAX_CONNECTIONS=200
# MAILCUBBY_SMTP_MAX_CONNECTIONS_PER_IP=20
# MAILCUBBY_SMTP_TIMEOUT=60s
# MAILCUBBY_SMTP_AUTH_MAX_FAILURES=5
# MAILCUBBY_SMTP_AUTH_LOCKOUT=15m
# MAILCUBBY_SMTP_RATE_LIMIT=600/m

# --- Retention and storage ---------------------------------------------------
# Per-project defaults; 0 disables a limit
# MAILCUBBY_RETENTION_MAX_AGE=30d
# MAILCUBBY_RETENTION_MAX_MESSAGES=5000
# MAILCUBBY_RETENTION_MAX_BYTES=1GiB
# MAILCUBBY_RETENTION_INTERVAL=5m
# Hard cap on all stored raw bytes; 0 = unlimited
# MAILCUBBY_INSTANCE_MAX_BYTES=0
# MAILCUBBY_AUDIT_RETENTION=180d
# MAILCUBBY_ZSTD_LEVEL=3
