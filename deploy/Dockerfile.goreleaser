# Runtime-only multi-arch image built by GoReleaser (ARCHITECTURE 9.2).
FROM --platform=$BUILDPLATFORM alpine:3.21 AS prep
RUN mkdir -p /out/data

FROM gcr.io/distroless/static-debian13:nonroot
ARG TARGETPLATFORM
COPY ${TARGETPLATFORM}/mailcubby /mailcubby
COPY --from=prep --chown=65532:65532 /out/data /data
ENV MAILCUBBY_DATA_DIR=/data
VOLUME /data
EXPOSE 1025 8025
HEALTHCHECK --interval=30s --timeout=3s --start-period=10s CMD ["/mailcubby", "healthcheck"]
ENTRYPOINT ["/mailcubby"]
CMD ["serve"]
