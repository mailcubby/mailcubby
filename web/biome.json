{
  "$schema": "https://biomejs.dev/schemas/2.6.9/schema.json",
  "files": {
    "includes": [
      "**",
      "!dist",
      "!node_modules",
      "!test-results",
      "!playwright-report",
      "!blob-report",
      "!pnpm-lock.yaml",
      "!pnpm-workspace.yaml",
      "!src/routeTree.gen.ts",
      "!src/api/schema.d.ts"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "security": {
        "noDangerouslySetInnerHtml": "error"
      },
      "suspicious": {
        "noExplicitAny": "error"
      }
    }
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  }
}
